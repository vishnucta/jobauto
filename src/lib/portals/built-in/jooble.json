{
  "format": 1,
  "id": "JOOBLE",
  "name": "Jooble",
  "version": "1.0.0",
  "description": "Jooble's own job index. A key is for one country (Germany's is asked for on de.jooble.org), and it only shares the start of each posting.",
  "tag": "One country per key · free key, 500 searches in all",
  "keyUrl": "https://jooble.org/api/about",
  "countries": null,
  "kinds": [
    "any"
  ],
  "radius": true,
  "hosts": [
    "jooble.org"
  ],
  "base": "https://jooble.org/api",
  "fields": [
    {
      "name": "key",
      "type": "secret",
      "label": "API key"
    }
  ],
  "quota": {
    "period": "in all"
  },
  "credit": {
    "text": "Jobs by Jooble"
  },
  "kind": "json",
  "search": {
    "url": "{base}/{fields.key}",
    "paging": {
      "type": "page",
      "size": 20,
      "total": "totalCount"
    },
    "items": "jobs",
    "posting": {
      "id": "id",
      "title": {
        "path": "title",
        "clean": "html"
      },
      "company": {
        "path": "company",
        "clean": "html"
      },
      "place": {
        "path": "location",
        "clean": "html"
      },
      "salary": {
        "text": "salary"
      },
      "postedAt": {
        "path": "updated",
        "as": "iso"
      },
      "url": {
        "path": "link",
        "link": true
      },
      "via": "source",
      "description": {
        "path": "snippet",
        "clean": "html"
      },
      "complete": false
    }
  },
  "details": {
    "type": "page"
  },
  "test": {
    "keywords": "developer",
    "place": "Berlin",
    "country": "de"
  }
}
